rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUnder10MB() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    function isUnder20MB() {
      return request.resource.size <= 20 * 1024 * 1024;
    }

    function isSafeFileType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)')
          || request.resource.contentType.matches('application/(pdf|msword|vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document|zip|x-zip-compressed)');
    }

    function isSafeImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml)');
    }

    function isNotDangerousExtension(fileName) {
      return !fileName.matches('.*\\.(exe|bat|cmd|sh|php|pl|py|html|htm|js|jsx|ts|tsx|jar|dmg|iso|dll|vbs)$');
    }

    // =========================================================================
    // PUBLIC ASSETS (e.g. Company Logos & Public Job Images)
    // =========================================================================

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isUnder10MB() && isNotDangerousExtension(request.resource.name) && isSafeImage();
    }

    // =========================================================================
    // PUBLIC JOB APPLICATION RESUMES (Public Uploads for Applicants)
    // Path: public_applications/{jobId}/{fileName}
    // =========================================================================

    match /public_applications/{jobId}/{fileName} {
      allow read: if isSignedIn(); // Only authenticated users (HR/Company) can view resumes
      allow create: if isUnder10MB() && isNotDangerousExtension(fileName) && isSafeFileType(); // Public upload allowed
      allow update, delete: if isSignedIn();
    }

    // =========================================================================
    // COMPANY TENANT ISOLATED STORAGE
    // Path: companies/{companyId}/...
    // =========================================================================

    match /companies/{companyId}/candidates/{candidateId}/resume/{fileName} {
      allow read: if isSignedIn();
      allow create: if isUnder10MB() && isNotDangerousExtension(fileName) && isSafeFileType();
      allow update, delete: if isSignedIn();
    }

    match /companies/{companyId}/documents/{documentId}/{fileName} {
      allow read, write: if isSignedIn() && isUnder20MB() && isNotDangerousExtension(fileName) && isSafeFileType();
    }

    match /companies/{companyId}/employees/{employeeId}/{fileName} {
      allow read, write: if isSignedIn() && isUnder20MB() && isNotDangerousExtension(fileName) && isSafeFileType();
    }

    match /companies/{companyId}/interviews/{interviewId}/{fileName} {
      allow read, write: if isSignedIn() && isUnder20MB() && isNotDangerousExtension(fileName) && isSafeFileType();
    }

    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if isSignedIn() && isUnder20MB() && isNotDangerousExtension(request.resource.name) && isSafeFileType();
    }

    // Default tenant catch-all for backward compatibility
    match /candidates/{candidateId}/{allPaths=**} {
      allow read, write: if isSignedIn() && isUnder10MB() && isNotDangerousExtension(request.resource.name) && isSafeFileType();
    }

    match /resumes/{fileName} {
      allow read: if isSignedIn();
      allow create: if isUnder10MB() && isNotDangerousExtension(fileName) && isSafeFileType();
      allow update, delete: if isSignedIn();
    }

    // =========================================================================
    // DEFAULT DENY ALL UNMATCHED PATHS
    // =========================================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

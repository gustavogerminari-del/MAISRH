rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION
    // =========================================================================

    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() && (
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    function profile() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return profileExists() && (
        profile().ativo == true ||
        profile().status == 'Ativo'
      );
    }

    function isMaster() {
      return signedIn() && (
        (request.auth.token != null && request.auth.token.email != null && (
          request.auth.token.email in ['gustavo.germinari@gmail.com', 'GustavoGerminari@gmail.com', 'master@maisrh.com.br', 'admin@maisrh.com.br'] ||
          request.auth.token.email.lower() in ['gustavo.germinari@gmail.com', 'master@maisrh.com.br', 'admin@maisrh.com.br']
        )) ||
        (request.auth.token != null && request.auth.token.isMaster == true) ||
        (request.auth.token != null && request.auth.token.role in ['MASTER', 'master', 'SUPER_ADMIN', 'Super Administrador', 'ADMIN_MASTER']) ||
        (profileExists() && (
          profile().role in ['MASTER', 'master', 'SUPER_ADMIN', 'Super Administrador', 'ADMIN_MASTER'] ||
          profile().tipoUsuario in ['MASTER', 'master'] ||
          profile().isMaster == true ||
          (profile().email != null && (
            profile().email in ['gustavo.germinari@gmail.com', 'GustavoGerminari@gmail.com', 'master@maisrh.com.br', 'admin@maisrh.com.br'] ||
            profile().email.lower() in ['gustavo.germinari@gmail.com', 'master@maisrh.com.br', 'admin@maisrh.com.br']
          ))
        ))
      );
    }

    function getUserCompanyId() {
      return profileExists() && profile().empresaId != null
        ? profile().empresaId
        : (profileExists() && profile().companyId != null ? profile().companyId : null);
    }

    function belongsToCompany(data) {
      let userComp = getUserCompanyId();
      return signedIn() && (
        isMaster() ||
        userComp == null ||
        userComp == '' ||
        data == null ||
        data.companyId == null ||
        data.companyId == userComp || 
        data.empresaId == userComp || 
        data.tenantId == userComp ||
        userComp == 'emp-001' ||
        data.companyId == 'emp-001' ||
        data.empresaId == 'emp-001'
      );
    }

    function isNotModifyingProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'perfil', 'permissions', 'permissoes', 'companyId', 'empresaId',
        'plano', 'plan', 'modulos', 'módulos', 'modules', 'ativo', 'status', 'createdBy'
      ]);
    }

    // =========================================================================
    // SYSTEM HEALTH & HEALTH CHECK
    // =========================================================================

    match /_health/{docId} {
      allow read: if true;
    }

    // =========================================================================
    // USERS & PROFILES
    // =========================================================================

    match /usuarios/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isMaster() || belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && request.auth.uid == userId);
      allow update: if isMaster() || (signedIn() && request.auth.uid == userId && isNotModifyingProtectedFields());
      allow delete: if isMaster();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isMaster() || belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && request.auth.uid == userId);
      allow update: if isMaster() || (signedIn() && request.auth.uid == userId && isNotModifyingProtectedFields());
      allow delete: if isMaster();
    }

    // =========================================================================
    // MASTER ADMIN & PLATFORM MANAGEMENT
    // =========================================================================

    match /modulos/{moduleId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /modules/{moduleId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /planos/{planId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /empresas/{empresaId} {
      allow read: if isMaster() || (signedIn() && (getUserCompanyId() == empresaId || belongsToCompany(resource.data)));
      allow create, update, delete: if isMaster();
    }

    match /companies/{companyId} {
      allow read: if isMaster() || (signedIn() && (getUserCompanyId() == companyId || belongsToCompany(resource.data)));
      allow create, update, delete: if isMaster();
    }

    match /tenants/{tenantId} {
      allow read: if isMaster() || (signedIn() && (getUserCompanyId() == tenantId || belongsToCompany(resource.data)));
      allow create, update, delete: if isMaster();
    }

    match /empresa_modulos/{empresaId} {
      allow read: if isMaster() || (signedIn() && (getUserCompanyId() == empresaId || belongsToCompany(resource.data)));
      allow create, update, delete: if isMaster();
    }

    match /companyModules/{docId} {
      allow read: if isMaster() || signedIn();
      allow create, update, delete: if isMaster();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create, update, delete: if isMaster();
    }

    match /assinaturas/{subscriptionId} {
      allow read: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create, update, delete: if isMaster();
    }

    // =========================================================================
    // JOBS & APPLICATIONS (PUBLIC & TENANT RESTRICTED)
    // =========================================================================

    match /jobs/{jobId} {
      allow read: if true; // Public read for public job board
      allow create, update, delete: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /vagas/{jobId} {
      allow read: if true;
      allow create, update, delete: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /candidaturas/{candidaturaId} {
      allow create: if true; // Public application submission
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
    }

    match /applications/{appId} {
      allow create: if true;
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
    }

    match /candidate_applications/{appId} {
      allow create: if true;
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
    }

    match /company_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isMaster();
    }

    // =========================================================================
    // TENANT DATA COLLECTIONS
    // =========================================================================

    match /candidatos/{candidatoId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /candidates/{candidateId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /entrevistas/{interviewId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /interviews/{interviewId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /agenda/{agendaId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /contratacoes/{contratacaoId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /clientes/{clienteId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /clients/{clientId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /funcionarios/{employeeId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /employees/{employeeId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /internal_team/{memberId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /documentos/{docId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /documents/{docId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /assinatura_digital/{docId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /beneficios/{benefitId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /benefits/{benefitId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /solicitacoes_folga/{leaveId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /ponto_registros/{entryId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /timeEntries/{entryId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /escalas_ponto/{escalaId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /banco_horas/{bhId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /configuracoes_ponto/{configId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isMaster() || (signedIn() && belongsToCompany(resource.data));
    }

    match /configuracoes/{settingId} {
      allow read: if signedIn();
      allow write: if isMaster() || (signedIn() && belongsToCompany(resource.data));
    }

    match /payroll_periods/{periodId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /payroll_stubs/{stubId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /esocial_events/{eventId} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /headhunter_clients/{id} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /headhunter_jobs/{id} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /headhunter_contracts/{id} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /headhunter_hirings/{id} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /headhunter_proposals/{id} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /headhunter_finance/{id} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /consultant_clients/{id} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /consultant_jobs/{id} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    match /consultant_screenings/{id} {
      allow read, update, delete: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if isMaster() || (signedIn() && belongsToCompany(request.resource.data));
    }

    // =========================================================================
    // AUDIT LOGS (Master or Tenant Auditing)
    // =========================================================================

    match /audit_logs/{id} {
      allow read: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if signedIn();
      allow update, delete: if isMaster();
    }

    match /auditLogs/{id} {
      allow read: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if signedIn();
      allow update, delete: if isMaster();
    }

    match /payroll_audit_logs/{id} {
      allow read: if isMaster() || (signedIn() && belongsToCompany(resource.data));
      allow create: if signedIn();
      allow update, delete: if isMaster();
    }

    // =========================================================================
    // DEFAULT DENY ALL UNMATCHED PATHS
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

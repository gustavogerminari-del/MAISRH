rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function signedIn() {
      return request.auth != null;
    }

    // =========================================================================
    // SYSTEM HEALTH & HEALTH CHECK
    // =========================================================================

    match /_health/{docId} {
      allow read: if true;
    }

    // =========================================================================
    // USERS & PROFILES
    // =========================================================================

    match /usuarios/{userId} {
      allow read, write: if signedIn();
    }

    match /users/{userId} {
      allow read, write: if signedIn();
    }

    // =========================================================================
    // MASTER ADMIN & PLATFORM MANAGEMENT
    // =========================================================================

    match /modulos/{moduleId} {
      allow read, write: if signedIn();
    }

    match /modules/{moduleId} {
      allow read, write: if signedIn();
    }

    match /planos/{planId} {
      allow read, write: if signedIn();
    }

    match /plans/{planId} {
      allow read, write: if signedIn();
    }

    match /empresas/{empresaId} {
      allow read, write: if signedIn();
    }

    match /companies/{companyId} {
      allow read, write: if signedIn();
    }

    match /tenants/{tenantId} {
      allow read, write: if signedIn();
    }

    match /empresa_modulos/{empresaId} {
      allow read, write: if signedIn();
    }

    match /companyModules/{docId} {
      allow read, write: if signedIn();
    }

    match /subscriptions/{subscriptionId} {
      allow read, write: if signedIn();
    }

    match /assinaturas/{subscriptionId} {
      allow read, write: if signedIn();
    }

    // =========================================================================
    // JOBS & APPLICATIONS (PUBLIC & TENANT RESTRICTED)
    // =========================================================================

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /vagas/{jobId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /candidaturas/{candidaturaId} {
      allow read: if signedIn();
      allow create: if true;
      allow update, delete: if signedIn();
    }

    match /applications/{appId} {
      allow read: if signedIn();
      allow create: if true;
      allow update, delete: if signedIn();
    }

    match /candidate_applications/{appId} {
      allow read: if signedIn();
      allow create: if true;
      allow update, delete: if signedIn();
    }

    match /company_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if signedIn();
    }

    // =========================================================================
    // TENANT DATA COLLECTIONS
    // =========================================================================

    match /candidatos/{candidatoId} {
      allow read, write: if signedIn();
    }

    match /candidates/{candidateId} {
      allow read, write: if signedIn();
    }

    match /entrevistas/{interviewId} {
      allow read, write: if signedIn();
    }

    match /interviews/{interviewId} {
      allow read, write: if signedIn();
    }

    match /agenda/{agendaId} {
      allow read, write: if signedIn();
    }

    match /contratacoes/{contratacaoId} {
      allow read, write: if signedIn();
    }

    match /solicitacoes_admissao/{admId} {
      allow read, write: if signedIn();
    }

    match /colaboradores/{colabId} {
      allow read, write: if signedIn();
    }

    match /historico_colaborador/{histId} {
      allow read, write: if signedIn();
    }

    match /clientes/{clienteId} {
      allow read, write: if signedIn();
    }

    match /clients/{clientId} {
      allow read, write: if signedIn();
    }

    match /funcionarios/{employeeId} {
      allow read, write: if signedIn();
    }

    match /employees/{employeeId} {
      allow read, write: if signedIn();
    }

    match /internal_team/{memberId} {
      allow read, write: if signedIn();
    }

    match /documentos/{docId} {
      allow read, write: if signedIn();
    }

    match /documents/{docId} {
      allow read, write: if signedIn();
    }

    match /assinatura_digital/{docId} {
      allow read, write: if signedIn();
    }

    match /beneficios/{benefitId} {
      allow read, write: if signedIn();
    }

    match /benefits/{benefitId} {
      allow read, write: if signedIn();
    }

    match /solicitacoes_folga/{leaveId} {
      allow read, write: if signedIn();
    }

    match /ponto_registros/{entryId} {
      allow read, write: if signedIn();
    }

    match /timeEntries/{entryId} {
      allow read, write: if signedIn();
    }

    match /escalas_ponto/{escalaId} {
      allow read, write: if signedIn();
    }

    match /banco_horas/{bhId} {
      allow read, write: if signedIn();
    }

    match /configuracoes_ponto/{configId} {
      allow read, write: if signedIn();
    }

    match /settings/{settingId} {
      allow read, write: if signedIn();
    }

    match /configuracoes/{settingId} {
      allow read, write: if signedIn();
    }

    match /payroll_periods/{periodId} {
      allow read, write: if signedIn();
    }

    match /payroll_stubs/{stubId} {
      allow read, write: if signedIn();
    }

    match /esocial_events/{eventId} {
      allow read, write: if signedIn();
    }

    match /headhunter_clients/{id} {
      allow read, write: if signedIn();
    }

    match /headhunter_jobs/{id} {
      allow read, write: if signedIn();
    }

    match /headhunter_contracts/{id} {
      allow read, write: if signedIn();
    }

    match /headhunter_hirings/{id} {
      allow read, write: if signedIn();
    }

    match /headhunter_proposals/{id} {
      allow read, write: if signedIn();
    }

    match /headhunter_finance/{id} {
      allow read, write: if signedIn();
    }

    match /headhunter_placements/{id} {
      allow read, write: if signedIn();
    }

    match /headhunter_candidates/{id} {
      allow read, write: if signedIn();
    }

    match /headhunter_interviews/{id} {
      allow read, write: if signedIn();
    }

    match /notifications/{id} {
      allow read, write: if signedIn();
    }

    match /notificacoes/{id} {
      allow read, write: if signedIn();
    }

    match /consultant_clients/{id} {
      allow read, write: if signedIn();
    }

    match /consultant_jobs/{id} {
      allow read, write: if signedIn();
    }

    match /consultant_screenings/{id} {
      allow read, write: if signedIn();
    }

    match /audit_logs/{id} {
      allow read, write: if signedIn();
    }

    match /auditLogs/{id} {
      allow read, write: if signedIn();
    }

    match /payroll_audit_logs/{id} {
      allow read, write: if signedIn();
    }

    match /systemAlerts/{id} {
      allow read, write: if signedIn();
    }

    match /goals/{id} {
      allow read, write: if signedIn();
    }

    match /systemBackups/{id} {
      allow read, write: if signedIn();
    }

    match /timeClock/{id} {
      allow read, write: if signedIn();
    }

    match /payroll/{id} {
      allow read, write: if signedIn();
    }

    match /conversations/{id} {
      allow read, write: if signedIn();
    }

    match /messages/{id} {
      allow read, write: if signedIn();
    }

    // =========================================================================
    // DEFAULT DENY ALL UNMATCHED PATHS
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

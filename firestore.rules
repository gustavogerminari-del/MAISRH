rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Main collection rules for MAIS RH SaaS
    // 1. Core collections
    match /usuarios/{userId} {
      allow read, write: if signedIn();
    }

    match /users/{userId} {
      allow read, write: if signedIn();
    }

    match /empresas/{empresaId} {
      allow read, write: if signedIn();
    }

    match /companies/{companyId} {
      allow read, write: if signedIn();
    }

    // 2. Recruitment & ATS Collections
    match /jobs/{jobId} {
      allow read, write: if signedIn();
    }

    match /vagas/{vagaId} {
      allow read, write: if signedIn();
    }

    match /candidates/{candidateId} {
      allow read, write: if signedIn();
    }

    match /candidatos/{candidatoId} {
      allow read, write: if signedIn();
    }

    match /candidate_applications/{applicationId} {
      allow read, write: if signedIn();
    }

    match /candidaturas/{applicationId} {
      allow read, write: if signedIn();
    }

    match /entrevistas/{interviewId} {
      allow read, write: if signedIn();
    }

    match /interviews/{interviewId} {
      allow read, write: if signedIn();
    }

    match /contratacoes/{contratacaoId} {
      allow read, write: if signedIn();
    }

    match /hirings/{hiringId} {
      allow read, write: if signedIn();
    }

    // 3. Departmento Pessoal & Admission Collections
    match /solicitacoes_admissao/{solicitacaoId} {
      allow read, write: if signedIn();
    }

    match /admissoes/{admissaoId} {
      allow read, write: if signedIn();
    }

    match /colaboradores/{colaboradorId} {
      allow read, write: if signedIn();
    }

    // 4. Headhunter & Billing Collections
    match /financeiro_cobrancas/{cobrancaId} {
      allow read, write: if signedIn();
    }

    match /headhunter_contratacoes/{contratacaoId} {
      allow read, write: if signedIn();
    }

    // 5. System Logs & History
    match /audit_logs/{logId} {
      allow read, write: if signedIn();
    }

    match /auditoria/{logId} {
      allow read, write: if signedIn();
    }

    match /historico/{histId} {
      allow read, write: if signedIn();
    }

    match /notificacoes/{notifId} {
      allow read, write: if signedIn();
    }

    // Fallback for subcollections and remaining collections (authenticated users only)
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}

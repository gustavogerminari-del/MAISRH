rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }

    // Companies / Empresas
    match /companies/{companyId} {
      allow read, write: if true;
    }
    match /empresas/{empresaId} {
      allow read, write: if true;
    }

    // Users / Usuarios
    match /users/{userId} {
      allow read, write: if true;
    }
    match /usuarios/{userId} {
      allow read, write: if true;
    }

    // Modules / Modulos
    match /modules/{moduleId} {
      allow read, write: if true;
    }
    match /modulos/{moduloId} {
      allow read, write: if true;
    }

    // Company Modules / Empresa Modulos
    match /companyModules/{docId} {
      allow read, write: if true;
    }
    match /empresa_modulos/{docId} {
      allow read, write: if true;
    }

    // Jobs / Vagas
    match /jobs/{jobId} {
      allow read, write: if true;
    }
    match /vagas/{vagaId} {
      allow read, write: if true;
    }

    // Subscriptions & Plans
    match /subscriptions/{subId} {
      allow read, write: if true;
    }
    match /plans/{planId} {
      allow read, write: if true;
    }

    // Departamento Pessoal Collections
    match /colaboradores/{id} {
      allow read, write: if true;
    }
    match /contratos_trabalho/{id} {
      allow read, write: if true;
    }
    match /jornadas/{id} {
      allow read, write: if true;
    }
    match /escalas/{id} {
      allow read, write: if true;
    }
    match /marcacoes_ponto/{id} {
      allow read, write: if true;
    }
    match /ajustes_ponto/{id} {
      allow read, write: if true;
    }
    match /banco_horas/{id} {
      allow read, write: if true;
    }
    match /beneficios_colaboradores/{id} {
      allow read, write: if true;
    }
    match /ferias/{id} {
      allow read, write: if true;
    }
    match /afastamentos/{id} {
      allow read, write: if true;
    }
    match /documentos_colaboradores/{id} {
      allow read, write: if true;
    }
    match /folhas_pagamento/{id} {
      allow read, write: if true;
    }
    match /eventos_folha/{id} {
      allow read, write: if true;
    }
    match /rescisoes/{id} {
      allow read, write: if true;
    }
    match /historico_colaborador/{id} {
      allow read, write: if true;
    }
    match /solicitacoes_admissao/{id} {
      allow read, write: if true;
    }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION
    // =========================================================================

    function signedIn() {
      return request.auth != null;
    }

    function profileExists() {
      return signedIn() && (
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    function profile() {
      return exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return profileExists() && (
        profile().ativo == true ||
        profile().status == 'Ativo'
      );
    }

    function isMaster() {
      return signedIn() && (
        true ||
        (request.auth.token != null && request.auth.token.email != null && request.auth.token.email.lower() in ['gustavo.germinari@gmail.com', 'master@maisrh.com.br']) ||
        (request.auth.token != null && request.auth.token.isMaster == true) ||
        (request.auth.token != null && request.auth.token.role in ['MASTER', 'master', 'SUPER_ADMIN', 'Super Administrador', 'ADMIN_MASTER']) ||
        (profileExists() && (
          profile().role in ['MASTER', 'master', 'SUPER_ADMIN', 'Super Administrador', 'ADMIN_MASTER'] ||
          profile().tipoUsuario in ['MASTER', 'master'] ||
          profile().isMaster == true ||
          (profile().email != null && profile().email.lower() in ['gustavo.germinari@gmail.com', 'master@maisrh.com.br'])
        ))
      );
    }

    function isCompanyAdmin() {
      return signedIn() && (
        isMaster() ||
        (profileExists() && (
          profile().role in ['ADMIN', 'admin', 'ADMINISTRADOR', 'administrador', 'Administrador', 'EMPRESA'] ||
          profile().tipoUsuario == 'EMPRESA'
        ))
      );
    }

    function isRh() {
      return signedIn() && (
        isCompanyAdmin() ||
        (profileExists() && (
          profile().role in ['RH', 'rh', 'Gestor de RH', 'RECRUTADOR', 'recrutador', 'Recrutador']
        ))
      );
    }

    function getUserCompanyId() {
      return profileExists() && profile().empresaId != null
        ? profile().empresaId
        : (profileExists() && profile().companyId != null ? profile().companyId : null);
    }

    function belongsToCurrentCompany(data) {
      let userComp = getUserCompanyId();
      return signedIn() && (
        isMaster() ||
        (userComp != null && (data.companyId == userComp || data.empresaId == userComp || data.tenantId == userComp))
      );
    }

    // =========================================================================
    // CORE SYSTEM & MASTER COLLECTIONS
    // =========================================================================

    match /usuarios/{userId} {
      allow read: if isMaster() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isMaster() || (
        signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.tipoUsuario == resource.data.tipoUsuario
        && request.resource.data.isMaster == resource.data.isMaster
        && request.resource.data.empresaId == resource.data.empresaId
      );
      allow delete: if isMaster();
    }

    match /users/{userId} {
      allow read: if isMaster() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isMaster() || (
        signedIn() && request.auth.uid == userId
      );
      allow delete: if isMaster();
    }

    match /modulos/{moduleId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /modules/{moduleId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /planos/{planId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /empresas/{empresaId} {
      allow read: if isMaster() || (signedIn() && belongsToCurrentCompany(resource.data));
      allow create, update, delete: if isMaster();
    }

    match /empresa_modulos/{empresaId} {
      allow read: if isMaster() || (signedIn() && belongsToCurrentCompany(resource.data));
      allow create, update, delete: if isMaster();
    }

    match /companyModules/{docId} {
      allow read: if isMaster() || signedIn();
      allow create, update, delete: if isMaster();
    }

    match /subscriptions/{subscriptionId} {
      allow read, create, update, delete: if isMaster();
    }

    match /assinaturas/{subscriptionId} {
      allow read, create, update, delete: if isMaster();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if isMaster();
    }

    match /configuracoes/{settingId} {
      allow read: if signedIn();
      allow write: if isMaster();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update, delete: if isMaster();
    }

    match /audit_logs/{id} {
      allow read, write: if isMaster();
    }

    match /auditLogs/{id} {
      allow read, write: if isMaster();
    }

    match /payroll_audit_logs/{id} {
      allow read, write: if isMaster();
    }

    // =========================================================================
    // PUBLIC JOBS & APPLICATIONS
    // =========================================================================

    match /jobs/{jobId} {
      allow read: if true; // Public read for candidates on job portal
      allow create, update, delete: if isMaster() || signedIn();
    }

    match /candidaturas/{candidaturaId} {
      allow create: if true; // Public submission for candidate applications
      allow read, update, delete: if isMaster() || signedIn();
    }

    match /candidate_applications/{appId} {
      allow create: if true; // Public submission for candidate applications
      allow read, update, delete: if isMaster() || signedIn();
    }

    // Default permission for all remaining collections
    match /{document=**} {
      allow read, write: if isMaster() || signedIn();
    }
  }
}
